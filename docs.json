{
  "$schema": "https://mintlify.com/docs.json",
  "name": "Arcyria",
  "description": "Documentation for Arcyria database and SaaS pipelines, including MongoDB source and destination connections, transformations, runs, billing, and security.",
  "theme": "almond",
  "colors": {
    "primary": "#2563ef",
    "light": "#171717",
    "dark": "#91c5ff"
  },
  "thumbnails": {
    "fonts": {
      "family": "Geist"
    }
  },
  "logo": {
    "light": "/images/brand-logo/light-logo.png",
    "dark": "/images/brand-logo/dark-logo.png",
    "href": "https://arcyria.com"
  },
  "favicon": {
    "light": "/images/brand-logo/light-logo.png",
    "dark": "/images/brand-logo/dark-logo.png"
  },
  "appearance": {
    "default": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "family": "Geist",
    "body": {
      "family": "Geist"
    },
    "heading": {
      "family": "Georgia",
      "weight": 500
    }
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#f9fafb",
      "dark": "#090a0b"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Talk to us",
        "href": "mailto:support@arcyria.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Launch app",
      "href": "https://cloud.arcyria.com"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Introduction",
            "icon": "sparkles",
            "pages": ["index"]
          },
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": [
              "getting-started/introduction",
              "getting-started/quick-start",
              "getting-started/core-concepts",
              "getting-started/faq"
            ]
          },
          {
            "group": "Connections",
            "icon": "database",
            "pages": [
              "connections/overview",
              "connections/private-database-access"
            ]
          },
          {
            "group": "Connector Reference",
            "icon": "plug",
            "pages": [
              "connections/sources/database/postgresql",
              "connections/sources/database/mysql",
              "connections/sources/database/mongodb",
              "connections/sources/database/clickhouse",
              "connections/sources/database/duckdb",
              "connections/sources/productivity/airtable",
              "connections/sources/productivity/asana",
              "connections/sources/productivity/linear",
              "connections/sources/productivity/notion",
              "connections/sources/developer-tools/github",
              "connections/sources/customer-support/zendesk",
              "connections/sources/cms/strapi",
              "connections/sources/crm/hubspot",
              "connections/sources/finance/stripe",
              "connections/destinations/postgresql",
              "connections/destinations/mysql",
              "connections/destinations/mongodb",
              "connections/destinations/clickhouse",
              "connections/destinations/duckdb",
              "connections/destinations/airtable"
            ]
          },
          {
            "group": "Pipelines",
            "icon": "git-branch",
            "pages": [
              "pipelines/overview",
              "pipelines/creating"
            ]
          },
          {
            "group": "Transformations",
            "icon": "braces",
            "pages": [
              "pipelines/transformation-rules",
              "pipelines/normalisation",
              "pipelines/dbt-layer",
              "pipelines/data-type-compatibility"
            ]
          },
          {
            "group": "Scheduling and Sync Modes",
            "icon": "refresh-cw",
            "pages": [
              "pipelines/sync-modes",
              "pipelines/schedule",
              "sync-reference/full-sync",
              "sync-reference/incremental-sync",
              "sync-reference/sync-state"
            ]
          },
          {
            "group": "Pipeline Runs",
            "icon": "history",
            "pages": [
              "pipelines/run-history"
            ]
          },
          {
            "group": "Workspace",
            "icon": "building-2",
            "pages": [
              "platform/organisation",
              "platform/team-members"
            ]
          },
          {
            "group": "Billing and Usage",
            "icon": "credit-card",
            "pages": [
              "pricing",
              "billing-breakdown"
            ]
          },
          {
            "group": "Security and Data Handling",
            "icon": "shield-check",
            "pages": [
              "platform/security",
              "platform/data-privacy"
            ]
          },
          {
            "group": "Troubleshooting",
            "icon": "circle-help",
            "pages": ["troubleshooting/index"]
          },
          {
            "group": "Examples and Updates",
            "icon": "flask-conical",
            "pages": [
              "example/pipelines/postgres-to-postgres",
              "example/pipelines/postgres-incremental",
              "example/pipelines/stripe-to-postgres",
              "example/pipelines/hubspot-to-postgres",
              "example/pipelines/airtable-and-mysql",
              "example/pipelines/clickhouse-and-mysql",
              "example/pipelines/mongodb-and-postgresql",
              "example/pipelines/asana-to-destinations"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "icon": "layout-dashboard",
        "groups": [
          {
            "group": "Visual user guide",
            "icon": "book-open",
            "pages": [
              "user-guide/index",
              "user-guide/oria-copilot",
              "user-guide/connections",
              "user-guide/pipelines",
              "user-guide/transformations-and-branches",
              "user-guide/organizations",
              "user-guide/activity-and-edge-cases"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://arcyria.com"
    }
  }
}
