{
  "$schema": "https://mintlify.com/docs.json",
  "name": "MantrixFlow",
  "description": "Documentation for MantrixFlow — ELT pipelines, connectors, sync modes, and the workspace app.",
  "theme": "almond",
  "colors": {
    "primary": "#00a859",
    "light": "#4ade80",
    "dark": "#15803d"
  },
  "thumbnails": {
    "fonts": {
      "family": "Geist"
    }
  },
  "logo": {
    "light": "/images/logo-wordmark-light.svg",
    "dark": "/images/logo-wordmark-dark.svg",
    "href": "https://mantrixflow.com"
  },
  "favicon": "/favicon.ico",
  "appearance": {
    "default": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "family": "Geist",
    "body": {
      "family": "Geist"
    },
    "heading": {
      "family": "Georgia",
      "weight": 500
    }
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#ffffff",
      "dark": "#09090b"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Talk to us",
        "href": "mailto:support@mantrixflow.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://cloud.mantrixflow.com"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
  "navigation": {
    "tabs": [
      {
        "tab": "Documentation",
        "icon": "book-open",
        "groups": [
          {
            "group": "Introduction",
            "icon": "sparkles",
            "pages": [
              "index"
            ]
          },
          {
            "group": "Getting started",
            "icon": "rocket",
            "pages": [
              "getting-started/introduction",
              "getting-started/quick-start",
              "getting-started/core-concepts",
              "getting-started/faq"
            ]
          },
          {
            "group": "Pricing",
            "icon": "credit-card",
            "pages": [
              "pricing"
            ]
          },
          {
            "group": "Connections",
            "icon": "database",
            "pages": [
              "connections/overview",
              "connections/private-database-access",
              {
                "group": "Sources",
                "pages": [
                  {
                    "group": "Database",
                    "pages": [
                      "connections/sources/database/postgresql",
                      "connections/sources/database/mysql",
                      "connections/sources/database/mariadb",
                      "connections/sources/database/sqlite",
                      "connections/sources/database/cockroachdb"
                    ]
                  },
                  {
                    "group": "SaaS",
                    "pages": [
                      "connections/sources/ecommerce/shopify",
                      "connections/sources/finance/stripe",
                      "connections/sources/crm/hubspot",
                      "connections/sources/developer-tools/github",
                      "connections/sources/productivity/notion"
                    ]
                  }
                ]
              },
              {
                "group": "Destinations",
                "pages": [
                  "connections/destinations/postgresql",
                  "connections/destinations/mysql",
                  "connections/destinations/mariadb",
                  "connections/destinations/sqlite",
                  "connections/destinations/cockroachdb"
                ]
              }
            ]
          },
          {
            "group": "Pipelines",
            "icon": "git-branch",
            "pages": [
              "pipelines/overview",
              "pipelines/creating",
              "pipelines/normalisation",
              "pipelines/dbt-layer",
              "pipelines/data-type-compatibility",
              "pipelines/sync-modes",
              "pipelines/transformation-rules",
              "pipelines/schedule",
              "pipelines/run-history"
            ]
          },
          {
            "group": "Sync reference",
            "icon": "refresh-cw",
            "pages": [
              "sync-reference/full-sync",
              "sync-reference/incremental-sync",
              "sync-reference/sync-state"
            ]
          },
          {
            "group": "Platform",
            "icon": "building-2",
            "pages": [
              "platform/organisation",
              "platform/team-members",
              "platform/security",
              "platform/data-privacy"
            ]
          }
        ]
      },
      {
        "tab": "Guides",
        "icon": "layout-dashboard",
        "groups": [
          {
            "group": "User guide",
            "icon": "book-open",
            "pages": [
              "user-guide/index",
              "user-guide/connections",
              "user-guide/pipelines",
              "user-guide/transformations-and-branches",
              "user-guide/organizations",
              "user-guide/activity-and-edge-cases"
            ]
          },
          {
            "group": "Examples",
            "icon": "flask-conical",
            "pages": [
              "example/pipelines/postgres-to-postgres",
              "example/pipelines/postgres-to-postgres-examples"
            ]
          }
        ]
      }
    ]
  },
  "footer": {
    "socials": {
      "website": "https://mantrixflow.com"
    }
  }
}
