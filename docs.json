{
  "$schema": "https://mintlify.com/docs.json",
  "name": "MantrixFlow",
  "description": "Documentation for MantrixFlow — ETL pipelines, connectors, sync modes, and the workspace app.",
  "theme": "almond",
  "colors": {
    "primary": "#059669",
    "light": "#34d399",
    "dark": "#047857"
  },
  "logo": {
    "light": "/images/m.png",
    "dark": "/images/m.png",
    "href": "https://mantrixflow.com"
  },
  "favicon": "/favicon.ico",
  "appearance": {
    "default": "system"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "family": "Plus Jakarta Sans",
    "heading": {
      "family": "Plus Jakarta Sans"
    }
  },
  "background": {
    "decoration": "gradient"
  },
  "navbar": {
    "links": [
      {
        "label": "Website",
        "href": "https://mantrixflow.com"
      },
      {
        "label": "App",
        "href": "https://cloud.mantrixflow.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Open app",
      "href": "https://cloud.mantrixflow.com"
    }
  },
  "styling": {
    "codeblocks": {
