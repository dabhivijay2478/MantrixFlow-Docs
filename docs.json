{
  "$schema": "https://mintlify.com/docs.json",
  "name": "MantrixFlow",
  "description": "Documentation for MantrixFlow — ETL pipelines, connectors, sync modes, and the workspace app.",
  "theme": "almond",
  "colors": {
    "primary": "#00a859",
    "light": "#4ade80",
    "dark": "#15803d"
  },
  "thumbnails": {
    "fonts": {
      "family": "Geist"
    }
  },
  "logo": {
    "light": "/images/m.png",
    "dark": "/images/m.png",
    "href": "https://mantrixflow.com"
  },
  "favicon": "/favicon.ico",
  "appearance": {
    "default": "dark"
  },
  "icons": {
    "library": "lucide"
  },
  "fonts": {
    "family": "Geist",
    "body": {
      "family": "Geist"
    },
    "heading": {
      "family": "Georgia",
      "weight": 500
    }
  },
  "background": {
    "decoration": "gradient",
    "color": {
      "light": "#ffffff",
      "dark": "#09090b"
    }
  },
  "navbar": {
    "links": [
      {
        "label": "Talk to us",
        "href": "mailto:support@mantrixflow.com"
      }
    ],
    "primary": {
      "type": "button",
      "label": "Get started",
      "href": "https://cloud.mantrixflow.com"
    }
  },
  "styling": {
    "codeblocks": {
      "theme": {
        "light": "github-light",
        "dark": "github-dark"
      }
    }
  },
